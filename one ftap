    function FGM.StartLoopRagdoll()
        FGM.State.LoopRagdollEnabled = true
        FGM.SpawnRagdoll()
        task.spawn(function()
            local wasRagdolled = false
            local notRagdolledSince = nil
            local ragdollFrame = 0
            local ragdollDestroyInterval = 6 + math.random(7)
            while FGM.State.LoopRagdollEnabled do
                local target = FGM.State.TargetCharacter
                local tRoot = target and target:FindFirstChild('HumanoidRootPart')
                local tHum = target and target:FindFirstChildOfClass('Humanoid')
                local myChar = FGM.GetCharacter(FGM.LocalPlayer)
                local myRoot = myChar and myChar:FindFirstChild('HumanoidRootPart')
                local myHead = myChar and myChar:FindFirstChild('Head')
                local pallet = FGM.State.PalletForRagdoll
                if not (tRoot and tHum and myRoot) then RunService.RenderStepped:Wait() continue end
                local dist = (tRoot.Position - myRoot.Position).Magnitude
                if dist > 30 then
                    myRoot.CFrame = tRoot.CFrame * CFrame.new(0, 2, 4)
                    myRoot.AssemblyLinearVelocity = Vector3.zero
                    myRoot.AssemblyAngularVelocity = Vector3.zero
                    for _, v in pairs(tRoot:GetChildren()) do
                        if v:IsA('BodyPosition') or v:IsA('BodyGyro') then pcall(function() v:Destroy() end) end
                    end
                    pcall(function() setNetworkOwnerEvent:FireServer(tRoot, tRoot.CFrame) end)
                    pcall(function() createGrabLineEvent:FireServer(tRoot, Vector3.zero, tRoot.Position, false) end)
                    pcall(function() destroyGrabLineEvent:FireServer(tRoot) end)
                    task.wait(0.3)
                    notRagdolledSince = nil
                    wasRagdolled = false
                    ragdollFrame = 0
                    RunService.RenderStepped:Wait()
                    continue
                end
                pcall(function()
                    tHum.PlatformStand = true
                    tHum.Sit = true
                    tHum.AutoRotate = false
                    tHum:ChangeState(Enum.HumanoidStateType.Physics)
                end)
                local ragdolled = tHum:FindFirstChild('Ragdolled')
                local isRagdolled = ragdolled and ragdolled.Value == true
                if isRagdolled then
                    notRagdolledSince = nil
                    if not tRoot:FindFirstChild('ClickerBodyPos') then
                        for _, v in pairs(tRoot:GetChildren()) do
                            if v:IsA('BodyPosition') or v:IsA('BodyGyro') then pcall(function() v:Destroy() end) end
                        end
                        local bp = Instance.new('BodyPosition')
                        bp.Name = 'ClickerBodyPos'
                        bp.MaxForce = Vector3.new(9e9, 9e9, 9e9)
                        bp.D = 500
                        bp.P = 100000
                        bp.Position = tRoot.Position
                        bp.Parent = tRoot
                        local bg = Instance.new('BodyGyro')
                        bg.Name = 'ClickerBodyGyro'
                        bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
                        bg.D = 500
                        bg.P = 100000
                        bg.CFrame = tRoot.CFrame
                        bg.Parent = tRoot
                    end
                    local bp = tRoot:FindFirstChild('ClickerBodyPos')
                    if bp then
                        bp.Position = (myHead and myHead.Position or myRoot.Position) + myRoot.CFrame:VectorToWorldSpace(Vector3.new(0, 15, 0))
                    end
                    local bg = tRoot:FindFirstChild('ClickerBodyGyro')
                    if bg then bg.CFrame = CFrame.Angles(0, 0, 0) end
                    ragdollFrame = ragdollFrame + 1
                    if ragdollFrame >= ragdollDestroyInterval then
                        ragdollFrame = 0
                        ragdollDestroyInterval = 6 + math.random(7)
                        pcall(function() setNetworkOwnerEvent:FireServer(tRoot, tRoot.CFrame) end)
                        pcall(function() destroyGrabLineEvent:FireServer(tRoot) end)
                    end
                else
                    if not notRagdolledSince then
                        notRagdolledSince = tick()
                    elseif tick() - notRagdolledSince > 1 then
                        for _, v in pairs(tRoot:GetChildren()) do
                            if v:IsA('BodyPosition') or v:IsA('BodyGyro') then pcall(function() v:Destroy() end) end
                        end
                        pcall(function() setNetworkOwnerEvent:FireServer(tRoot, CFrame.lookAt(myRoot.Position, tRoot.Position)) end)
                        pcall(function() destroyGrabLineEvent:FireServer(tRoot) end)
                        tHum.PlatformStand = false
                        tHum.Sit = false
                        local oldPos = tRoot.Position
                        local moveTicks = 0
                        while moveTicks < 120 do
                            RunService.Heartbeat:Wait()
                            moveTicks = moveTicks + 1
                            if (tRoot.Position - oldPos).Magnitude > 0.1 then break end
                        end
                        pcall(function()
                            tHum.PlatformStand = true
                            tHum.AutoRotate = false
                            tHum:ChangeState(Enum.HumanoidStateType.Physics)
                        end)
                        pcall(function() createGrabLineEvent:FireServer(tRoot, Vector3.zero, tRoot.Position, false) end)
                        pcall(function() destroyGrabLineEvent:FireServer(tRoot) end)
                        ragdollFrame = 0
                        wasRagdolled = false
                        notRagdolledSince = nil
                    end
                end
                pcall(function() setNetworkOwnerEvent:FireServer(tRoot, tRoot.CFrame) end)
                if wasRagdolled and not isRagdolled then
                    pcall(function() setNetworkOwnerEvent:FireServer(tRoot, tRoot.CFrame) end)
                    pcall(function() createGrabLineEvent:FireServer(tRoot, Vector3.zero, tRoot.Position, false) end)
                    pcall(function() destroyGrabLineEvent:FireServer(tRoot) end)
                end
                if pallet and pallet.Parent then
                    local sp = pallet:FindFirstChild('SoundPart')
                    if sp and tRoot and tRoot.Parent then
                        for _, part in pairs(pallet:GetChildren()) do
                            if part:IsA("BasePart") then
                                pcall(function() setNetworkOwnerEvent:FireServer(part, part.CFrame) end)
                                pcall(function() setNetworkOwnerEvent:FireServer(part, part.CFrame) end)
                                pcall(function() createGrabLineEvent:FireServer(part, Vector3.zero, part.Position, false) end)
                                pcall(function() destroyGrabLineEvent:FireServer(part) end)
                            end
                        end
                        sp.CFrame = tRoot.CFrame
                        if tHum then
                            pcall(function() tHum.PlatformStand = true end)
                            pcall(function() tHum.Sit = false end)
                        end
                        task.wait(0.05)
                        sp.CFrame = myRoot.CFrame * CFrame.new(0, 1000, 0)
                    end
                end
                wasRagdolled = isRagdolled
                RunService.RenderStepped:Wait()
            end
        end)
    end
