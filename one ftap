            local name = model.Name
            if name ~= "TractorGreen" and name ~= "TractorRed" and name ~= "TractorOrange" then
                if Settings.Misc._tractorGyro then Settings.Misc._tractorGyro:Destroy() Settings.Misc._tractorGyro = nil end
