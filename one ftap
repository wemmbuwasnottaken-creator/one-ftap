function MiscFeature.BreakHouseBarrierBest(mode)
    if not mode then return end
    local barrierBroken = false
    local barrierConn
    barrierConn = Workspace.ChildAdded:Connect(function(child)
        if barrierBroken then
            if barrierConn then barrierConn:Disconnect() barrierConn = nil end
            return
        end
        if child.Name == "Part" then
            local ok, distance = pcall(function()
                return (child.Position - Vector3.new(263.4, -4.79, 466.8)).Magnitude
            end)
            if ok and distance <= 2 then
                barrierBroken = true
                pcall(function()
                    library:Notify({Title = "หมายเหตุจ้า!", Description = "กำแพงบ้านพังเรียบร้อย โอ๊ะโอ", Time = 3})
                end)
                local plots = Workspace:FindFirstChild("Plots")
                if plots then
                    for _, plot in pairs(plots:GetChildren()) do
                        local barrier = plot:FindFirstChild("Barrier")
                        if barrier then
                            for _, part in pairs(barrier:GetChildren()) do
                                if part:IsA("BasePart") and part.CanCollide == true then
                                    part.CanCollide = false
                                end
                            end
                        end
                    end
                end
                if barrierConn then barrierConn:Disconnect() barrierConn = nil end
            end
        end
    end)
    local startTime = tick()
    repeat
        pcall(function()
            SpawnToyRF:InvokeServer(
                "BallSnowball",
                CFrame.new(263.5, -4.5, 486.9),
                Vector3.new(0, 0, 0)
            )
        end)
        local wStart = tick()
        repeat
            task.wait()
        until not LocalPlayer:FindFirstChild("CanSpawnToy") or LocalPlayer.CanSpawnToy.Value or tick() - wStart > 2
    until barrierBroken or tick() - startTime >= 10
    if barrierConn then barrierConn:Disconnect() barrierConn = nil end
