            mirrorBeamObj.CurveSize0 = -beam.CurveSize0
            mirrorBeamObj.CurveSize1 = -beam.CurveSize1
            mirrorBeamObj.ZOffset = (beamZOffsetEnabled and beamZOffset or 0) + 0.02
