local packetHookedRemotes = {}
local function packetNotify(title, text)
    pcall(function()
        library:Notify({Title = title or "Packet Detected", Description = text or "", Time = 7})
    end)
end
local function packetResolveSender(args)
    for _, v in ipairs(args) do
        if typeof(v) == "Instance" then
            if v:IsA("Player") then return v end
            local model = v:IsA("Model") and v or v:FindFirstAncestorOfClass("Model")
            if model then
                local plr = Players:GetPlayerFromCharacter(model)
                if plr then return plr end
            end
        end
    end
    return LocalPlayer
end
local function packetShortenString(str)
    if #str <= 80 then return str end
    return str:sub(1, 80) .. "... (+" .. tostring(#str - 80) .. " chars)"
end
local function packetSummarizeTable(tbl)
    local preview = {}
    local count = 0
    for _, v in pairs(tbl) do
        count = count + 1
        if count <= 5 then
            local s, val = pcall(tostring, v)
            table.insert(preview, s and val or "unknown")
        end
    end
    return "table[" .. count .. "] { " .. table.concat(preview, ", ") .. (count > 5 and " ... }" or " }")
end
local function packetCompressArgs(args)
    local seen = {}
    local summary = {}
    for _, v in ipairs(args) do
        local key
        if typeof(v) == "string" then
            key = "str:" .. packetShortenString(v)
        elseif typeof(v) == "Instance" then
            local className = "Unknown"
            local name = "Unknown"
            pcall(function() className = v.ClassName end)
            pcall(function() name = v.Name end)
            key = "inst:" .. className .. "(" .. name .. ")"
        elseif typeof(v) == "table" then
            key = "tbl:" .. packetSummarizeTable(v)
        else
            local success, strVal = pcall(tostring, v)
            key = typeof(v) .. ":" .. (success and strVal or "unprintable")
        end
        seen[key] = (seen[key] or 0) + 1
    end
    for k, count in pairs(seen) do
        if count > 1 then
            table.insert(summary, k .. " x" .. count)
        else
            table.insert(summary, k)
        end
    end
    return summary
end
local function packetStringBytes(args)
    local total = 0
    for _, v in ipairs(args) do
        if typeof(v) == "string" then
            total = total + #v
        end
    end
    return total
end
local function packetExtractStrings(args)
    local parts = {}
    for _, v in ipairs(args) do
        if typeof(v) == "string" and #v > 0 then
            table.insert(parts, v)
        end
    end
    if #parts == 0 then return "None" end
    local full = table.concat(parts, " | ")
    if #full > 200 then full = full:sub(1, 200) .. "... (+" .. tostring(#full - 200) .. ")" end
    return full
end
local packetDetectorHandler
packetDetectorHandler = function(eventType, remoteName, remote, ...)
    local args = {...}
    local totalBytes = packetStringBytes(args)
    if totalBytes < PACKET_MIN_BYTES then return end
    if tick() - packetDetectorNotifyTick < 0.5 then return end
    packetDetectorNotifyTick = tick()
    local sender = packetResolveSender(args)
    local senderName = "Unknown"
    if sender then
        local s, name = pcall(function() return sender.DisplayName or sender.Name end)
        if s then senderName = name end
        if sender == LocalPlayer then senderName = senderName .. " (You)" end
    end
    local mbSize = totalBytes / (1024 * 1024)
    local summarized = packetCompressArgs(args)
    local argsStr = #summarized > 0 and table.concat(summarized, "\n") or "None"
    local textContent = Settings.Misc.showTextPackets and packetExtractStrings(args) or ""
    local desc
    if Settings.Misc.showTextPackets then
        desc = string.format("Player: %s\nSize: %.4f MB\nText: %s\nArgs:\n%s", senderName, mbSize, textContent, argsStr)
    else
        desc = string.format("Player: %s\nSize: %.4f MB", senderName, mbSize)
    end
    library:Notify({
        Title = string.format("[%s] %s", eventType, remoteName),
        Description = desc,
        Time = 6
    })
end
local function packetHookRemote(eventType, remoteName, remote)
    if not remote or not remote:IsA("RemoteEvent") then return end
    if packetDetectorHandlers[remoteName] then return end
    local handler = function(...)
        pcall(packetDetectorHandler, eventType, remoteName, remote, ...)
    end
    packetDetectorHandlers[remoteName] = handler
    local conn = remote.OnClientEvent:Connect(handler)
    packetDetectorConnFor[remoteName] = conn
    packetHookedRemotes[remoteName] = remote
    table.insert(packetDetectorConns, conn)
end
local function packetCheckAndHookBlobRemote(child)
    if child:IsA("RemoteEvent") and child.Name == "RelayClientAnimation" then
        local parent = child.Parent
        if parent and parent.Name == "BlobmanAnimations" then
            local grandParentName = parent.Parent and parent.Parent.Name or "Unknown"
            packetHookRemote("Blob", grandParentName, child)
        end
    end
end
local function packetScanForRemotes()
    for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
        if obj:IsA("RemoteEvent") then
            packetHookRemote("Grab", obj.Name, obj)
        end
    end
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("RemoteEvent") then
            packetHookRemote("Grab", obj.Name, obj)
        end
        packetCheckAndHookBlobRemote(obj)
    end
end
local function packetStartDetector()
    if packetDetectorEnabled then return end
    packetDetectorEnabled = true
    State.packetBlockOutgoing = false
    packetScanForRemotes()
    table.insert(packetDetectorConns, ReplicatedStorage.DescendantAdded:Connect(function(child)
        if child:IsA("RemoteEvent") then packetHookRemote("Grab", child.Name, child) end
    end))
    table.insert(packetDetectorConns, workspace.DescendantAdded:Connect(packetCheckAndHookBlobRemote))
end
local function packetStopDetector()
    packetDetectorEnabled = false
    State.packetBlockOutgoing = false
    for _, conn in ipairs(packetDetectorConns) do
        if typeof(conn) == "RBXScriptConnection" then pcall(function() conn:Disconnect() end) end
    end
    packetDetectorConns = {}
    packetDetectorHandlers = {}
    packetDetectorConnFor = {}
end
