local GlobalPCLDTracker = {
    players = {},
    playerList = {},
    pclds = {},
    parts = {},
    nameCache = {},
    recordConn = nil,
    addedConn = nil,
    removingConn = nil,
    playerAddedConn = nil,
    playerRemovingConn = nil,
    initialized = false,
    TRACK_MAX = 48,
    TRACK_WINDOW = 2.5,
    MAX_DELAY = 2.25,
    SAMPLE_INTERVAL = 0.08,
    OWNER_CACHE_TTL = 0.75,
    MATCH_DISTANCE = 2.0,
    MATCH_ROTATION = 0.35,
    ownerMarkerNames = { "PartOwner", "Owner", "OwnerName", "Player", "PlayerName" },
    attributeNames = { "Owner", "Player", "PlayerName", "Target" }
}

function GlobalPCLDTracker.init()
    if GlobalPCLDTracker.initialized then return end
    GlobalPCLDTracker.initialized = true

    for _, plr in ipairs(Players:GetPlayers()) do
        table.insert(GlobalPCLDTracker.playerList, plr)
        GlobalPCLDTracker.players[plr] = {}
    end

    GlobalPCLDTracker.playerAddedConn = Players.PlayerAdded:Connect(function(plr)
        table.insert(GlobalPCLDTracker.playerList, plr)
        GlobalPCLDTracker.players[plr] = GlobalPCLDTracker.players[plr] or {}
    end)

    GlobalPCLDTracker.playerRemovingConn = Players.PlayerRemoving:Connect(function(plr)
        GlobalPCLDTracker.players[plr] = nil
        for i = #GlobalPCLDTracker.playerList, 1, -1 do
            if GlobalPCLDTracker.playerList[i] == plr then
                table.remove(GlobalPCLDTracker.playerList, i)
                break
            end
        end
    end)

    local function trackPcld(part)
        if part and part:IsA("BasePart") and part.Name == "PlayerCharacterLocationDetector" then
            GlobalPCLDTracker.parts[part] = true
            if not GlobalPCLDTracker.pclds[part] then
                GlobalPCLDTracker.pclds[part] = {}
            end
        end
    end

    for _, obj in ipairs(Workspace:GetDescendants()) do
        trackPcld(obj)
    end

    GlobalPCLDTracker.addedConn = Workspace.DescendantAdded:Connect(trackPcld)
    GlobalPCLDTracker.removingConn = Workspace.DescendantRemoving:Connect(function(obj)
        if GlobalPCLDTracker.parts[obj] then
            GlobalPCLDTracker.parts[obj] = nil
            GlobalPCLDTracker.pclds[obj] = nil
            GlobalPCLDTracker.nameCache[obj] = nil
        end
    end)

    local function recordEntry(hist, t, cf)
        table.insert(hist, { t = t, cf = cf })
        if #hist > GlobalPCLDTracker.TRACK_MAX then
            table.remove(hist, 1)
        end
    end

    local lastRecordT = 0
    GlobalPCLDTracker.recordConn = RunService.Heartbeat:Connect(function()
        local now = tick()
        if now - lastRecordT < GlobalPCLDTracker.SAMPLE_INTERVAL then return end
        lastRecordT = now

        for _, plr in ipairs(GlobalPCLDTracker.playerList) do
            local char = plr.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if hrp and hrp.Parent then
                local hist = GlobalPCLDTracker.players[plr]
                if not hist then hist = {} GlobalPCLDTracker.players[plr] = hist end
                recordEntry(hist, now, hrp.CFrame)
            end
        end

        for part in pairs(GlobalPCLDTracker.parts) do
            if part and part.Parent then
                local hist = GlobalPCLDTracker.pclds[part]
                if not hist then hist = {} GlobalPCLDTracker.pclds[part] = hist end
                recordEntry(hist, now, part.CFrame)
            else
                GlobalPCLDTracker.parts[part] = nil
                GlobalPCLDTracker.pclds[part] = nil
                GlobalPCLDTracker.nameCache[part] = nil
            end
        end
    end)
end

function GlobalPCLDTracker.pcldOwnerMarker(pcld)
    if not pcld or not pcld.Parent then return nil end
    for _, markerName in ipairs(GlobalPCLDTracker.ownerMarkerNames) do
        local marker = pcld:FindFirstChild(markerName)
        if marker then
            local s, val = pcall(function() return tostring(marker.Value) end)
            if s and val and val ~= "" then
                for _, plr in ipairs(GlobalPCLDTracker.playerList) do
                    if plr.Parent and (plr.Name == val or plr.DisplayName == val) then
                        return plr
                    end
                end
            end
        end
    end
    for _, attrName in ipairs(GlobalPCLDTracker.attributeNames) do
        local attr = pcld:GetAttribute(attrName)
        if attr then
            local val = tostring(attr)
            if val ~= "" then
                for _, plr in ipairs(GlobalPCLDTracker.playerList) do
                    if plr.Parent and (plr.Name == val or plr.DisplayName == val) then
                        return plr
                    end
                end
            end
        end
    end
    return nil
end

local function frameMatchScore(a, b)
    local distance = (a.Position - b.Position).Magnitude
    if distance > GlobalPCLDTracker.MATCH_DISTANCE then return 0 end
    local lookError = (a.LookVector - b.LookVector).Magnitude
    local upError = (a.UpVector - b.UpVector).Magnitude
    local rotationError = lookError + upError * 0.5
    if rotationError > GlobalPCLDTracker.MATCH_ROTATION then return 0 end
    local positionScore = 1 - distance / GlobalPCLDTracker.MATCH_DISTANCE
    local rotationScore = 1 - rotationError / GlobalPCLDTracker.MATCH_ROTATION
    return positionScore * 0.65 + rotationScore * 0.35
end

function GlobalPCLDTracker.getOwnerPlayer(pcld)
    if not pcld or not pcld.Parent then return nil end
    GlobalPCLDTracker.init()

    local now = tick()
    local direct = GlobalPCLDTracker.pcldOwnerMarker(pcld)
    if direct then
        GlobalPCLDTracker.nameCache[pcld] = { player = direct, score = 1, time = now }
        return direct
    end

    local cached = GlobalPCLDTracker.nameCache[pcld]
    if cached and now - cached.time < GlobalPCLDTracker.OWNER_CACHE_TTL then
        if cached.player and cached.player.Parent then
            return cached.player
        end
        return nil
    end

    local pcldHist = GlobalPCLDTracker.pclds[pcld]
    if not pcldHist or #pcldHist == 0 then
        pcldHist = {{ t = now, cf = pcld.CFrame }}
    end

    local candidates = {}
    local sampleCount = 0
    for i = #pcldHist, 1, -1 do
        local sample = pcldHist[i]
        if now - sample.t > GlobalPCLDTracker.TRACK_WINDOW then break end
        sampleCount = sampleCount + 1
        for _, plr in ipairs(GlobalPCLDTracker.playerList) do
            local hist = GlobalPCLDTracker.players[plr]
            if hist and #hist > 0 and plr.Parent then
                local data = candidates[plr]
                if not data then
                    data = { matched = 0, total = 0, delayTotal = 0, delaySquared = 0 }
                    candidates[plr] = data
                end
                local best, bestDelay = 0, nil
                for j = #hist, 1, -1 do
                    local playerSample = hist[j]
                    local delay = sample.t - playerSample.t
                    if delay > GlobalPCLDTracker.MAX_DELAY then break end
                    if delay >= -0.12 then
                        local score = frameMatchScore(sample.cf, playerSample.cf)
                        if score > best then
                            best = score
                            bestDelay = delay
                        end
                    end
                end
                if best > 0 then
                    data.matched = data.matched + 1
                    data.total = data.total + best
                    data.delayTotal = data.delayTotal + bestDelay
                    data.delaySquared = data.delaySquared + bestDelay * bestDelay
                end
            end
        end
    end

    local bestPlayer, bestScore
    local candidateScores = {}
    local minMatches = math.min(6, sampleCount)
    for plr, data in pairs(candidates) do
        if data.matched >= minMatches and minMatches > 0 then
            local coverage = data.matched / sampleCount
            local average = data.total / data.matched
            local meanDelay = data.delayTotal / data.matched
            local variance = math.max(0, data.delaySquared / data.matched - meanDelay * meanDelay)
            local delayStability = math.max(0, 1 - math.sqrt(variance) / 0.45)
            local score = coverage * 0.55 + average * 0.3 + delayStability * 0.15
            candidateScores[plr] = score
            if not bestScore or score > bestScore then
                bestScore = score
                bestPlayer = plr
            end
        end
    end

    if cached and cached.player and cached.player.Parent then
        local cachedScore = candidateScores[cached.player] or 0
        if cachedScore >= 0.25 and (not bestScore or cachedScore >= bestScore - 0.12) then
            bestPlayer = cached.player
            bestScore = cachedScore
        end
    end

    if bestPlayer then
        GlobalPCLDTracker.nameCache[pcld] = { player = bestPlayer, score = bestScore or 0, time = now }
        return bestPlayer
    end

    if cached and cached.player and cached.player.Parent and now - cached.time < 1.5 then
        return cached.player
    end

    GlobalPCLDTracker.nameCache[pcld] = { player = nil, score = 0, time = now }
    return nil
end

function GlobalPCLDTracker.getOwnerName(pcld)
    local plr = GlobalPCLDTracker.getOwnerPlayer(pcld)
    return plr and plr.DisplayName or nil
end

function GlobalPCLDTracker.getPCLDForPlayer(targetPlayer)
    if not targetPlayer or not targetPlayer.Parent then return nil end
    GlobalPCLDTracker.init()

    -- 1. Check direct marker/attribute or cached mapping
    for part in pairs(GlobalPCLDTracker.parts) do
        if part and part.Parent then
            local owner = GlobalPCLDTracker.getOwnerPlayer(part)
            if owner == targetPlayer then
                return part
            end
        end
    end

    -- 2. Fallback: proximity to character HRP
    local hrp = targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart")
    if hrp then
        local best, bestDist = nil, 60
        for part in pairs(GlobalPCLDTracker.parts) do
            if part and part.Parent then
                local p = part.Position
                if not (p.X == 0 and p.Y == 0 and p.Z == 0) then
                    local d = (p - hrp.Position).Magnitude
                    if d < bestDist then
                        bestDist = d
                        best = part
                    end
                end
            end
        end
        return best
    end
    return nil
end

function GlobalPCLDTracker.findClosestPCLD(pos, maxDist)
    if not pos then return nil, nil, maxDist end
    GlobalPCLDTracker.init()
    maxDist = maxDist or 50

    local bestPart, bestPlr, bestDist = nil, nil, maxDist
    for part in pairs(GlobalPCLDTracker.parts) do
        if part and part.Parent then
            local p = part.Position
            if not (p.X == 0 and p.Y == 0 and p.Z == 0) then
                local d = (p - pos).Magnitude
                if d <= bestDist then
                    bestDist = d
                    bestPart = part
                end
            end
        end
    end

    if bestPart then
        bestPlr = GlobalPCLDTracker.getOwnerPlayer(bestPart)
        if not bestPlr then
            local closestPlr, closestPdist = nil, math.huge
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer and plr.Character then
                    local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        local d = (hrp.Position - bestPart.Position).Magnitude
                        if d < closestPdist then
                            closestPdist = d
                            closestPlr = plr
                        end
                    end
                end
            end
            bestPlr = closestPlr
        end
    end

    return bestPart, bestPlr, bestDist
end

